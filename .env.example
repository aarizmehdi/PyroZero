# Optional SERVER-ONLY credentials. Leave keys empty for reference answers.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# DeepSeek is preferred when configured; failures are explicit, never labeled live fallback.
# Without DeepSeek, Gemini is tried before OpenAI; these providers retain deterministic fallback.
# Vercel: add DEEPSEEK_API_KEY as a Production secret, then redeploy.
# Visitors can override it with their own DeepSeek key in AI settings.
# Remove the Vercel variable and redeploy when shared access ends.
# Local Next.js: copy to .env.local. Never commit actual keys.
# Optional canonical URL, e.g. https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=
